# Kernel config fragment for the NexWipe Chromebook discovery build, merged on top of the Debian
# amd64 config (same Debian snapshot as the root filesystem) with scripts/kconfig/merge_config.sh.
# Stock Chromebook firmware (depthcharge) loads one kernel blob and no separate initrd, so the
# live-boot initramfs is built into the kernel. preflight.py refuses a kernel that lacks any
# option marked REQUIRED below, so a stock or foreign kernel cannot be packaged by mistake.

CONFIG_LOCALVERSION="-nexwipe-cb"
CONFIG_LOCALVERSION_AUTO=n

# REQUIRED: embedded config (lets preflight.py inspect the kernel) and xz payload/initramfs.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KERNEL_XZ=y
CONFIG_BLK_DEV_INITRD=y
# Filled in by build.sh pass 2 (directory kept by mkinitramfs -k).
CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_XZ=y

# REQUIRED: Chromebook firmware interfaces, read-only use (FWID/FRID/HWID/CHSW, VPD, coreboot tables).
CONFIG_CHROME_PLATFORMS=y
CONFIG_CHROMEOS_ACPI=y
CONFIG_GOOGLE_FIRMWARE=y
CONFIG_GOOGLE_COREBOOT_TABLE=y
CONFIG_GOOGLE_VPD=y
CONFIG_GOOGLE_SMI=n

# REQUIRED: internal eMMC (Intel SDHCI) and EXT_CSD via debugfs.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_DEBUG_FS=y

# REQUIRED: boot USB stick and the live filesystem stack, built in so the initramfs needs few modules.
# (Debian builds USB core as a module; the Renesas xHCI firmware loader would force xHCI to =m.)
CONFIG_USB_COMMON=y
CONFIG_USB=y
CONFIG_USB_XHCI_PCI_RENESAS=n
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXT4_FS=y

# Hibernation resume reads (and on resume, writes) a swap area: not built.
CONFIG_HIBERNATION=n

# Size/time trims: subsystems a Chromebook discovery station does not use.
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_XE=n
CONFIG_STAGING=n
CONFIG_INFINIBAND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_SOUND=n
CONFIG_BT=n
CONFIG_CAN=n
CONFIG_NFC=n
CONFIG_HAMRADIO=n
CONFIG_ISDN=n
CONFIG_FIREWIRE=n
CONFIG_XEN=n
CONFIG_HYPERV=n
CONFIG_VIRTUALIZATION=n
CONFIG_IIO=n
CONFIG_MTD=n
CONFIG_ATA_OVER_ETH=n
CONFIG_SCSI_LOWLEVEL=n
CONFIG_FUSION=n
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_GNSS=n
CONFIG_WWAN=n

# Build-host choices (no Debian signing certificate; faster build).
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_INFO_BTF=n
