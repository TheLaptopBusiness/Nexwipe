# Kernel config fragment for the NexWipe Chromebook discovery build, merged on top of the Debian
# amd64 config with scripts/kconfig/merge_config.sh. Stock Chromebook firmware (depthcharge) loads
# one kernel blob and no separate initrd, so the live-boot initramfs is built into the kernel.

CONFIG_LOCALVERSION="-nexwipe-cb"
# Filled in by build.sh pass 2 (directory produced by unmkinitramfs from the initramfs-tools image).
CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_COMPRESSION_XZ=y

# Chromebook firmware interfaces, read-only use: chromeos_acpi (FWID/FRID/HWID/CHSW), Google VPD,
# coreboot tables. The build never includes tools that write firmware or flags.
CONFIG_CHROME_PLATFORMS=y
CONFIG_CHROMEOS_ACPI=y
CONFIG_GOOGLE_FIRMWARE=y
CONFIG_GOOGLE_COREBOOT_TABLE=y
CONFIG_GOOGLE_VPD=y
CONFIG_GOOGLE_SMI=n
CONFIG_GOOGLE_MEMCONSOLE_COREBOOT=y

# Internal eMMC (Intel Braswell SDHCI) identification and EXT_CSD via debugfs.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_DEBUG_FS=y

# Boot USB stick.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_BLK_DEV_SD=y

# Build-time choices for an external build host (no Debian signing certificate, faster build).
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
