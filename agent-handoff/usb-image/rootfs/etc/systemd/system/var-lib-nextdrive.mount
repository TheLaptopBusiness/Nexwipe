[Unit]
Description=NexWipe station state partition (credential + metadata)
DefaultDependencies=no
Before=nd-console.service

[Mount]
What=/dev/disk/by-partlabel/ND-STATE
Where=/var/lib/nextdrive
Type=ext4
Options=rw,nosuid,nodev,noexec,noatime,nofail,x-systemd.device-timeout=10s

[Install]
WantedBy=local-fs.target
